{
  "name": "microservicio-evaluacion",
  "version": "1.0.0",
  "description": "Microservicio Express para evaluación DevOps con CI/CD, pruebas y Docker",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --coverage --coverageReporters=json-summary",
    "audit": "node scripts/audit-project.js",
    "monitoring:up": "bash scripts/monitoring-up.sh"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "app.js",
      "metrics.js",
      "logger.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 70,
        "lines": 75,
        "statements": 75
      }
    }
  }
}
